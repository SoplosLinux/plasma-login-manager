#!/bin/sh
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = "purge" ]; then
    deb-systemd-helper purge 'plasmalogin.service' >/dev/null || true

    # Remove the state this package created: the greeter's home, built by
    # tmpfiles, and the configuration written by postinst. Both are ours, so
    # purge is the point at which they should go.
    # The plasmalogin system user is deliberately left in place, as is usual
    # in Debian: removing a system user can orphan files owned by it elsewhere.
    rm -f "${DPKG_ROOT}/etc/plasmalogin.conf"
    rm -rf "${DPKG_ROOT}/var/lib/plasmalogin"
fi

#DEBHELPER#
